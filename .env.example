# === DATABASE ===
# PostgreSQL connection string (required)
# Make sure pgvector extension is installed: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://user:password@localhost:5432/ragdb

# === OPENAI ===
# Your OpenAI API key (required for RAG answer generation)
OPENAI_API_KEY=sk-...

# Optional: custom base URL (e.g. for Azure OpenAI or local LLM endpoints like Ollama)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: LLM model to use (default: gpt-4o)
# For local LLM via Ollama, set OPENAI_BASE_URL=http://localhost:11434/v1 and OPENAI_MODEL to your model name
# OPENAI_MODEL=gpt-4o

# === SERVER ===
# Port to run the server on (default: 5000)
PORT=5000
